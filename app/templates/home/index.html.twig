{% extends 'base.html.twig' %}

{% block title %}Resource Center{% endblock %}

{% block body %}
    <div class="page-shell" data-client-language-page>
        {% include 'shared/_header.html.twig' %}

        <main class="main">
            <section class="hero">
                <h1 id="heroTitle">{{ 'hero.title'|trans }}</h1>
                <div id="heroCopy" class="hero-copy">{{ 'hero.copy'|trans }}</div>
            </section>

            <section id="resources" class="cards resource-cards" aria-label="Resource categories">
                <article class="card">
                    <div class="card-top">
                        <div class="card-main">
                            <div class="resource-icon" aria-hidden="true"><img src="/assets/icons/Screen-Curved--Streamline-Ultimate.svg" alt=""></div>
                            <div class="text-block">
                                <div id="roomTitle" class="card-title">{{ 'resource.rooms'|trans }}</div>
                                <div class="card-meta">
                                    <span id="roomCount">{{ resource_cards.rooms.total }} {{ 'unit.spaces'|trans }}</span>
                                    <span id="roomAvailability">{{ resource_cards.rooms.available }} {{ 'unit.available'|trans }}</span>
                                </div>
                            </div>
                        </div>
                        <a class="card-action" href="{{ path('app_reservation', {type: 'room'}) }}" aria-label="{{ 'resource.rooms'|trans }}"><img src="/assets/icons/Arrow-Button-Right-1--Streamline-Ultimate%20(1).svg" alt=""></a>
                    </div>
                    <div id="roomDesc" class="card-text">{{ 'resource.room_description'|trans }}</div>
                </article>

                <article class="card">
                    <div class="card-top">
                        <div class="card-main">
                            <div class="resource-icon" aria-hidden="true"><img src="/assets/icons/Vehicle-Car-Personal-4--Streamline-Nova.png" alt=""></div>
                            <div class="text-block">
                                <div id="vehicleTitle" class="card-title">{{ 'resource.vehicles'|trans }}</div>
                                <div class="card-meta">
                                    <span id="vehicleCount">{{ resource_cards.vehicles.total }} {{ 'unit.vehicles'|trans }}</span>
                                    <span id="vehicleAvailability">{{ resource_cards.vehicles.available }} {{ 'unit.available'|trans }}</span>
                                </div>
                            </div>
                        </div>
                        <a class="card-action" href="{{ path('app_reservation', {type: 'vehicle'}) }}" aria-label="{{ 'resource.vehicles'|trans }}"><img src="/assets/icons/Arrow-Button-Right-1--Streamline-Ultimate%20(1).svg" alt=""></a>
                    </div>
                    <div id="vehicleDesc" class="card-text">{{ 'resource.vehicle_description'|trans }}</div>
                </article>

                <article class="card">
                    <div class="card-top">
                        <div class="card-main">
                            <div class="resource-icon" aria-hidden="true"><img src="/assets/icons/Tool-Box--Streamline-Ultimate.svg" alt=""></div>
                            <div class="text-block">
                                <div id="equipmentTitle" class="card-title">{{ 'resource.equipment'|trans }}</div>
                                <div class="card-meta">
                                    <span id="equipmentCount">{{ resource_cards.equipment.total }} {{ 'unit.items'|trans }}</span>
                                    <span id="equipmentAvailability">{{ resource_cards.equipment.available }} {{ 'unit.available'|trans }}</span>
                                </div>
                            </div>
                        </div>
                        <a class="card-action" href="{{ path('app_reservation', {type: 'equipment'}) }}" aria-label="{{ 'resource.equipment'|trans }}"><img src="/assets/icons/Arrow-Button-Right-1--Streamline-Ultimate%20(1).svg" alt=""></a>
                    </div>
                    <div id="equipmentDesc" class="card-text">{{ 'resource.equipment_description'|trans }}</div>
                </article>
            </section>

            {% include 'shared/_footer.html.twig' %}
        </main>
    </div>
    {% include 'shared/_scroll_to_top.html.twig' %}

    <script>
        const resourceStats = {{ resource_cards|json_encode|raw }};
        const translations = {{ translations|json_encode|raw }};

        function detectInitialLanguage() {
            const browserLocale = navigator.language || navigator.languages?.[0] || 'en-US';
            const localeCode = browserLocale.toLowerCase();
            return localeCode.startsWith('fr') ? 'fr' : 'en';
        }

        const languageToggle = document.getElementById('langToggle');
        let currentLanguage = localStorage.getItem('resource-center-lang') || detectInitialLanguage();

        function applyLanguage(lang) {
            const strings = translations[lang];
            if (!strings) return;

            applySharedLanguage(lang);
            document.getElementById('scrollUp').setAttribute('aria-label', strings.scrollUp);
            document.getElementById('scrollUp').setAttribute('title', strings.scrollUp);
            document.getElementById('heroTitle').textContent = strings.heroTitle;
            document.getElementById('heroCopy').textContent = strings.heroCopy;
            document.getElementById('roomTitle').textContent = strings.roomTitle;
            document.getElementById('roomCount').textContent = `${resourceStats.rooms.total} ${strings.spaces}`;
            document.getElementById('roomAvailability').textContent = `${resourceStats.rooms.available} ${strings.available}`;
            document.getElementById('roomDesc').textContent = strings.roomDesc;
            document.getElementById('vehicleTitle').textContent = strings.vehicleTitle;
            document.getElementById('vehicleCount').textContent = `${resourceStats.vehicles.total} ${strings.vehicles}`;
            document.getElementById('vehicleAvailability').textContent = `${resourceStats.vehicles.available} ${strings.available}`;
            document.getElementById('vehicleDesc').textContent = strings.vehicleDesc;
            document.getElementById('equipmentTitle').textContent = strings.equipmentTitle;
            document.getElementById('equipmentCount').textContent = `${resourceStats.equipment.total} ${strings.items}`;
            document.getElementById('equipmentAvailability').textContent = `${resourceStats.equipment.available} ${strings.available}`;
            document.getElementById('equipmentDesc').textContent = strings.equipmentDesc;
            document.getElementById('footerTitle').textContent = strings.footerTitle;
            document.getElementById('footerSubtitle').textContent = strings.footerSubtitle;

            document.documentElement.lang = lang;
            updateLanguageButton(lang);
            currentLanguage = lang;
            localStorage.setItem('resource-center-lang', lang);
        }

        languageToggle.addEventListener('click', function () {
            const nextLang = currentLanguage === 'fr' ? 'en' : 'fr';
            applyLanguage(nextLang);
        });

        applyLanguage(currentLanguage);
    </script>
{% endblock %}

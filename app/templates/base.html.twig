<!DOCTYPE html>
<html lang="{{ app.request.locale|default('en') }}">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{% block title %}Resource Center{% endblock %}</title>
        <style>
            :root {
                --bg: #ececeb;
                --panel: #f2f2f2;
                --soft: #f8f8f8;
                --white: #ffffff;
                --text: #1f2a37;
                --muted: #6d7278;
                --border: #d9d9d8;
                --purple: #800082;
                --purple-dark: #800082;
                --button: #2b2b2b;
                --shadow: rgba(28, 28, 28, 0.08);
            }

            * { box-sizing: border-box; }

            html, body {
                margin: 0;
                min-height: 100%;
                background: var(--bg);
                font-family: 'Trebuchet MS', 'Segoe UI', sans-serif;
                color: var(--text);
            }

            body {
                display: flex;
                justify-content: center;
            }

            .page-shell {
                width: 100%;
                max-width: 1440px;
                min-height: 100vh;
                background: var(--bg);
            }

            .topbar {
                height: 90px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 0 28px 0 24px;
                border-bottom: 1px solid var(--border);
            }

            .brand {
                display: flex;
                align-items: center;
                gap: 12px;
            }

            .brand-mark {
                width: 32px;
                height: 32px;
                border-radius: 50%;
                background: linear-gradient(135deg, #7ea574 0%, #5d8d61 100%);
                position: relative;
                box-shadow: inset 0 0 0 2px rgba(255,255,255,0.26);
            }

            .brand-mark::before {
                content: "";
                position: absolute;
                left: 9px;
                top: 7px;
                width: 14px;
                height: 10px;
                border-radius: 50% 50% 45% 45%;
                background: rgba(255,255,255,0.25);
            }

            .brand-mark::after {
                content: "";
                position: absolute;
                left: 14px;
                top: 18px;
                width: 8px;
                height: 8px;
                border-radius: 50%;
                background: rgba(255,255,255,0.25);
            }

            .brand-text {
                display: flex;
                flex-direction: column;
                line-height: 1.1;
            }

            .brand-name {
                font-size: 2rem;
                font-weight: 800;
                letter-spacing: -0.06em;
            }

            .brand-sub {
                font-size: 0.74rem;
                color: var(--muted);
                font-weight: 500;
            }

            .top-actions {
                display: flex;
                align-items: center;
                gap: 22px;
            }

            .lang-switch {
                border: 1px solid var(--border);
                background: rgba(0,0,0,0.03);
                color: var(--text);
                border-radius: 10px;
                padding: 8px 12px;
                font-weight: 700;
                font-size: 0.8rem;
                cursor: pointer;
                transition: all 0.2s ease;
            }

            .lang-switch:hover {
                background: rgba(0,0,0,0.05);
            }

            .nav {
                display: flex;
                align-items: center;
                gap: 28px;
            }

            .nav-item {
                font-weight: 500;
                color: var(--text);
                opacity: 0.9;
                font-size: 1.1rem;
                cursor: pointer;
            }

            .nav-item:first-child {
                padding: 10px 16px;
                border-radius: 14px;
                background: rgba(0,0,0,0.04);
            }

            .user-pill {
                position: relative;
            }

            .profile-toggle {
                display: flex;
                align-items: center;
                gap: 10px;
                background: linear-gradient(135deg, #8a3d7f 0%, #5f2b64 100%);
                color: white;
                border: 0;
                border-radius: 14px;
                padding: 10px 12px 10px 10px;
                min-width: 128px;
                justify-content: center;
                cursor: pointer;
                box-shadow: 0 6px 14px rgba(97, 48, 90, 0.15);
            }

            .profile-guest {
                color: var(--white);
                text-decoration: none;
            }

            .profile-toggle:focus-visible,
            .lang-switch:focus-visible,
            .card-action:focus-visible,
            .scroll-up:focus-visible {
                outline: 3px solid rgba(122, 47, 116, 0.35);
                outline-offset: 3px;
            }

            .profile-menu {
                position: absolute;
                z-index: 10;
                top: calc(100% + 10px);
                right: 0;
                display: grid;
                min-width: 150px;
                padding: 6px;
                border: 1px solid var(--border);
                border-radius: 12px;
                background: var(--white);
                box-shadow: 0 12px 28px var(--shadow);
            }

            .profile-menu[hidden] {
                display: none;
            }

            .profile-menu a {
                padding: 10px 12px;
                border-radius: 8px;
                color: var(--text);
                text-decoration: none;
                font-size: 0.88rem;
                font-weight: 600;
            }

            .profile-menu a:hover {
                background: rgba(122, 47, 116, 0.08);
            }

            .account-page {
                max-width: 620px;
                margin: 0 auto;
                padding: 64px 24px 80px;
            }

            .account-panel {
                background: var(--white);
                border: 1px solid var(--border);
                border-radius: 18px;
                padding: 32px;
                box-shadow: 0 12px 28px var(--shadow);
            }

            .account-panel h1 {
                font-size: clamp(2rem, 4vw, 3rem);
                letter-spacing: -0.06em;
                margin-bottom: 12px;
            }

            .account-label {
                display: inline-block;
                margin-bottom: 16px;
                color: var(--purple);
                font-size: 0.85rem;
                font-weight: 800;
                letter-spacing: 0.04em;
                text-transform: uppercase;
            }

            .account-intro,
            .account-note {
                color: var(--muted);
                line-height: 1.6;
            }

            .account-error {
                margin-top: 18px;
                padding: 12px 14px;
                border: 1px solid #d99898;
                border-radius: 10px;
                background: #fff4f4;
                color: #8b1e1e;
                font-weight: 600;
            }

            .account-form {
                display: grid;
                gap: 18px;
                margin-top: 28px;
            }

            .form-field {
                display: grid;
                gap: 8px;
            }

            .form-field label {
                font-size: 0.9rem;
                font-weight: 700;
            }

            .form-field input {
                width: 100%;
                border: 1px solid var(--border);
                border-radius: 10px;
                padding: 12px 14px;
                color: var(--text);
                background: var(--soft);
                font: inherit;
            }

            .account-button {
                border: 2px solid var(--purple);
                border-radius: 10px;
                padding: 12px 16px;
                background: var(--purple);
                color: var(--white);
                font: inherit;
                font-weight: 700;
                cursor: pointer;
            }

            .account-button:hover {
                background: var(--white);
                color: var(--purple);
            }

            .account-link {
                display: inline-block;
                margin-top: 24px;
                color: var(--purple);
                font-weight: 700;
                text-decoration: none;
            }

            .profile-summary {
                display: flex;
                align-items: center;
                gap: 16px;
                margin: 24px 0;
                padding: 16px;
                border-radius: 12px;
                background: var(--soft);
            }

            .profile-summary .avatar {
                flex: 0 0 auto;
                width: 48px;
                height: 48px;
            }

            .profile-summary strong {
                display: block;
                font-size: 1.1rem;
            }

            .profile-summary span {
                color: var(--muted);
                font-size: 0.9rem;
            }

            .avatar {
                width: 26px;
                height: 26px;
                border-radius: 50%;
                border: 2px solid rgba(255,255,255,0.7);
                background: linear-gradient(135deg, #e8d2a2, #c0a06c);
                position: relative;
            }

            .avatar::before {
                content: "";
                position: absolute;
                left: 6px;
                top: 5px;
                width: 12px;
                height: 8px;
                border-radius: 50% 50% 52% 52%;
                background: rgba(122, 86, 39, 0.7);
            }

            .avatar::after {
                content: "";
                position: absolute;
                left: 7px;
                bottom: 4px;
                width: 10px;
                height: 8px;
                border-radius: 50% 50% 48% 48%;
                background: rgba(122, 86, 39, 0.7);
            }

            .user-name {
                font-size: 1.08rem;
                font-weight: 700;
                letter-spacing: -0.02em;
            }

            .main {
                padding: 44px 0 0;
            }

            .hero {
                text-align: center;
                margin: 0 auto;
                max-width: 920px;
            }

            h1 {
                font-size: clamp(2.6rem, 4vw, 4rem);
                line-height: 0.96;
                margin: 0;
                letter-spacing: -0.08em;
                font-weight: 800;
                color: #1c2430;
            }

            .hero-copy {
                margin: 26px auto 0;
                max-width: 760px;
                font-size: 1.08rem;
                line-height: 1.7;
                color: #5e6c7a;
                font-weight: 500;
            }

            .cards {
                max-width: 980px;
                margin: 68px auto 0;
                display: grid;
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 18px 22px;
                padding: 0 24px;
            }

            .card {
                display: grid;
                grid-template-columns: minmax(0, 1fr);
                gap: 16px;
                background: rgba(248,248,248,0.7);
                border: 1px solid var(--border);
                border-radius: 18px;
                padding: 18px 18px 18px 16px;
                min-height: 120px;
                box-shadow: 0 1px 0 rgba(0,0,0,0.02);
            }

            .card-top {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 20px;
                min-width: 0;
            }

            .card-main {
                display: flex;
                align-items: center;
                gap: 14px;
            }

            .resource-icon {
                width: 52px;
                height: 52px;
                aspect-ratio: 1;
                border-radius: 12px;
                background: rgba(122, 47, 116, 0.1);
                color: var(--purple-dark);
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 12px;
                font-size: 1.2rem;
                border: 1px solid rgba(122, 47, 116, 0.12);
            }

            .resource-icon img {
                width: 26px;
                height: 26px;
                display: block;
                object-fit: contain;
                filter: invert(15%) sepia(93%) saturate(5291%) hue-rotate(294deg) brightness(76%) contrast(126%);
            }

            .text-block {
                display: flex;
                flex-direction: column;
                gap: 4px;
            }

            .card-title {
                font-size: 1.05rem;
                font-weight: 800;
                letter-spacing: -0.03em;
                color: #1e2530;
            }

            .card-meta {
                font-size: 0.85rem;
                color: var(--muted);
                font-weight: 500;
                display: flex;
                flex-direction: column;
                gap: 2px;
            }

            .card-text {
                font-size: 0.96rem;
                color: #5a6570;
                font-weight: 500;
                max-width: none;
                width: 100%;
            }

            .card-action {
                width: 40px;
                height: 40px;
                border-radius: 50%;
                border: 2px solid var(--purple);
                background: var(--purple);
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 0;
                color: var(--white);
                font-size: 1.2rem;
                flex-shrink: 0;
                cursor: pointer;
                transition: background 0.2s ease, border-color 0.2s ease;
            }

            .card-action img,
            .scroll-up img {
                width: 20px;
                height: 20px;
                display: block;
                filter: brightness(0) invert(1);
                transition: filter 0.2s ease;
            }

            .card-action:hover,
            .scroll-up:hover {
                background: var(--white);
                border-color: var(--purple);
            }

            .card-action:hover img,
            .scroll-up:hover img {
                filter: none;
            }

            .scroll-up img {
                transform: translateX(11px);
            }

            .card:nth-child(5) {
                grid-column: 1 / span 2;
                max-width: 660px;
                margin: 0 auto;
            }

            .footer-brand {
                text-align: center;
                padding: 56px 0 38px;
            }

            .footer-brand .brand-name {
                font-size: clamp(1.8rem, 2vw, 2.4rem);
            }

            .footer-brand .brand-sub {
                margin-top: 8px;
            }

            .scroll-up {
                position: fixed;
                right: 24px;
                bottom: 24px;
                z-index: 20;
                width: 46px;
                height: 46px;
                border: 2px solid var(--purple);
                border-radius: 50%;
                background: var(--purple);
                color: var(--white);
                font-size: 1.25rem;
                line-height: 1;
                cursor: pointer;
                padding: 0;
                opacity: 1;
                pointer-events: auto;
                transform: translateY(0);
                transition: opacity 0.2s ease, transform 0.2s ease, background 0.2s ease;
                box-shadow: 0 8px 18px rgba(28, 28, 28, 0.18);
            }

            .scroll-up.is-visible {
                opacity: 1;
                pointer-events: auto;
                transform: translateY(0);
            }

            @media (max-width: 900px) {
                .topbar {
                    padding: 0 14px;
                }

                .nav {
                    gap: 12px;
                }

                .nav-item {
                    font-size: 0.95rem;
                }

                .cards {
                    grid-template-columns: 1fr;
                }

                .card:nth-child(5) {
                    grid-column: auto;
                    max-width: none;
                }
            }

            @media (max-width: 620px) {
                .topbar {
                    flex-wrap: wrap;
                    height: auto;
                    padding: 18px 16px;
                    gap: 18px;
                }

                .top-actions {
                    width: 100%;
                    justify-content: space-between;
                }

                .scroll-up {
                    right: 16px;
                    bottom: 16px;
                }

                .nav {
                    flex-wrap: wrap;
                    justify-content: center;
                }

                .brand-name {
                    font-size: 1.6rem;
                }

                .hero {
                    padding: 0 18px;
                }

                .card {
                    padding: 16px 14px;
                }
            }
        </style>
    </head>
    <body>
        {% block body %}{% endblock %}
    </body>
</html>

{% extends 'base.html.twig' %}

{% block title %}{{ 'account.sign_in'|trans }} | Resource Center{% endblock %}

{% block body %}
    <div class="page-shell">
        {% include 'shared/_header.html.twig' %}
        <main class="account-page">
            <section class="account-panel" aria-labelledby="login-title">
                <div class="account-label">{{ 'account.resource_center'|trans }}</div>
                <h1 id="login-title">{{ 'account.sign_in'|trans }}</h1>
                <p id="loginIntro" class="account-intro">{{ 'account.intro'|trans }}</p>

                {% if error %}
                    <div id="loginError" class="account-error" role="alert">{{ error }}</div>
                {% endif %}

                <form class="account-form" method="post" action="{{ path('app_login') }}">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                    <div class="form-field">
                        <label id="emailLabel" for="email">{{ 'account.email'|trans }}</label>
                        <input id="email" name="email" type="email" autocomplete="email" required>
                    </div>
                    <div class="form-field">
                        <label id="passwordLabel" for="password">{{ 'account.password'|trans }}</label>
                        <input id="password" name="password" type="password" autocomplete="current-password" required>
                    </div>
                    <button id="loginSubmit" class="account-button" type="submit">{{ 'account.sign_in'|trans }}</button>
                </form>

                <p id="loginNote" class="account-note">{{ 'account.note'|trans }}</p>
            </section>
        </main>
        {% include 'shared/_footer.html.twig' %}
    </div>
    {% include 'shared/_scroll_to_top.html.twig' %}

    <script>
        const loginTranslations = {{ login_translations|json_encode|raw }};

        const loginLanguageToggle = document.getElementById('langToggle');
        const browserLanguage = (navigator.language || 'en').toLowerCase().startsWith('fr') ? 'fr' : 'en';
        let loginLanguage = localStorage.getItem('resource-center-lang') || browserLanguage;

        function applyLoginLanguage(language) {
            const strings = loginTranslations[language];
            document.documentElement.lang = language;
            document.getElementById('login-title').textContent = strings.title;
            document.getElementById('loginIntro').textContent = strings.intro;
            document.getElementById('emailLabel').textContent = strings.email;
            document.getElementById('passwordLabel').textContent = strings.password;
            document.getElementById('loginSubmit').textContent = strings.submit;
            document.getElementById('loginNote').textContent = strings.note;
            loginLanguageToggle.textContent = language === 'fr' ? 'EN' : 'FR';
            loginLanguageToggle.setAttribute('aria-label', strings.toggle);
            const error = document.getElementById('loginError');
            if (error) error.textContent = strings.error;
            loginLanguage = language;
            localStorage.setItem('resource-center-lang', language);
        }

        loginLanguageToggle.addEventListener('click', function () {
            applyLoginLanguage(loginLanguage === 'fr' ? 'en' : 'fr');
        });

        applyLoginLanguage(loginLanguage);
    </script>
{% endblock %}
Project Resource_Center {
  database_type: 'PostgreSQL'
  Note: '''
    Schéma issu de Reservations.sql et des migrations de flotte et d'équipements.
    Les ressources représentent les exemplaires physiques ; les groupes de modèles
    sont calculés par l'application, sans table de regroupement supplémentaire.
    Les triggers SQL de mise à jour des dates, de cohérence multi-entreprise,
    de prévention des chevauchements et d'audit ne sont pas implémentés par ce DBML.
  '''
}

Table companies {
  id int [pk, not null, increment]
  name varchar(255) [not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    name [unique, name: 'uq_companies_name']
  }
}

Table users {
  id int [pk, not null, increment]
  company_id int [not null]
  first_name varchar(120) [not null]
  last_name varchar(120) [not null]
  email varchar(255) [not null]
  phone_number varchar(40)
  password_hash varchar(255) [not null]
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (company_id, email) [unique, name: 'uq_users_company_email']
    (`lower(email)`) [unique, name: 'uq_users_email_global']
    company_id [name: 'idx_users_company']
  }
}

Table roles {
  id int [pk, not null, increment]
  name varchar(120) [not null]
  description text
  created_at timestamp [not null, default: `now()`]

  indexes {
    name [unique, name: 'uq_roles_name']
  }
}

Table user_roles {
  id int [pk, not null, increment]
  user_id int [not null]
  role_id int [not null]
  created_at timestamp [not null, default: `now()`]

  indexes {
    (user_id, role_id) [unique, name: 'uq_user_roles']
  }
}

Table permissions {
  id int [pk, not null, increment]
  name varchar(160) [not null]
  description text

  indexes {
    name [unique, name: 'uq_permissions_name']
  }
}

Table role_permissions {
  id int [pk, not null, increment]
  role_id int [not null]
  permission_id int [not null]
  created_at timestamp [not null, default: `now()`]

  indexes {
    (role_id, permission_id) [unique, name: 'uq_role_permissions']
  }
}

Table resource_types {
  id int [pk, not null, increment]
  name varchar(120) [not null]
  description text
  created_at timestamp [not null, default: `now()`]

  indexes {
    name [unique, name: 'uq_resource_types_name']
  }
}

Table resource_states {
  id int [pk, not null, increment]
  label varchar(120) [not null]
  description text

  indexes {
    label [unique, name: 'uq_resource_states_label']
  }
}

Table resources {
  id int [pk, not null, increment]
  company_id int [not null]
  type_id int [not null]
  state_id int [not null]
  name varchar(255) [not null]
  code varchar(80) [not null]
  location varchar(255)
  capacity int
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (company_id, code) [unique, name: 'uq_resources_company_code']
    (company_id, type_id, state_id) [name: 'idx_resources_company_type_state']
  }

  checks {
    `capacity IS NULL OR capacity >= 0` [name: 'chk_resources_capacity_positive']
  }
}

Table room_details {
  resource_id int [pk, not null]
  building varchar(255)
  floor varchar(40)
  has_screen boolean [not null, default: false]
  has_whiteboard boolean [not null, default: false]
  has_projector boolean [not null, default: false]
  available_places int
  created_at timestamp [not null, default: `now()`]

  checks {
    `available_places IS NULL OR available_places >= 0` [name: 'chk_room_places_positive']
  }
}

Table vehicle_details {
  resource_id int [pk, not null]
  license_plate varchar(30) [not null]
  brand varchar(120)
  model varchar(120)
  fuel_type varchar(80)
  vehicle_class varchar(80)
  created_at timestamp [not null, default: `now()`]

  indexes {
    license_plate [unique, name: 'uq_vehicle_license_plate']
  }
}

Table equipment_details {
  resource_id int [pk, not null]
  serial_number varchar(120)
  brand varchar(120)
  model varchar(120)
  category varchar(120)
  created_at timestamp [not null, default: `now()`]

  indexes {
    serial_number [unique, name: 'uq_equipment_serial_number']
  }
}

Table reservation_status {
  id int [pk, not null, increment]
  code varchar(60) [not null]
  label varchar(120) [not null]
  description text
  is_blocking boolean [not null, default: true]

  indexes {
    code [unique, name: 'uq_reservation_status_code']
    label [unique, name: 'uq_reservation_status_label']
  }
}

Table reservations {
  id int [pk, not null, increment]
  company_id int [not null]
  resource_id int [not null]
  user_id int [not null]
  status_id int [not null]
  start_at timestamp [not null]
  end_at timestamp [not null]
  title varchar(255) [not null]
  notes text
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (resource_id, start_at, end_at) [name: 'idx_reservations_resource_range']
    (company_id, start_at) [name: 'idx_reservations_company_start']
    (user_id, start_at) [name: 'idx_reservations_user_start']
  }

  checks {
    `end_at > start_at` [name: 'chk_reservations_dates']
  }

  Note: 'Triggers SQL : utilisateur et ressource de la même entreprise ; aucun chevauchement avec une réservation bloquante ou une maintenance.'
}

Table reservation_participants {
  id int [pk, not null, increment]
  reservation_id int [not null]
  user_id int
  email varchar(255)
  status varchar(60) [not null, default: 'invited']
  created_at timestamp [not null, default: `now()`]

  indexes {
    (reservation_id, user_id) [unique, name: 'uq_reservation_participants_user']
    (reservation_id, email) [unique, name: 'uq_reservation_participants_email']
  }

  checks {
    `user_id IS NOT NULL OR email IS NOT NULL` [name: 'chk_reservation_participant_target']
  }
}

Table vehicle_usage {
  reservation_id int [pk, not null]
  vehicle_id int [not null]
  checked_out_at timestamp
  returned_at timestamp
  issue_reported_at timestamp
  issue_description text
  issue_resolved_at timestamp

  indexes {
    vehicle_id [name: 'idx_vehicle_usage_vehicle']
  }

  checks {
    `returned_at IS NULL OR checked_out_at IS NOT NULL` [name: 'chk_vehicle_usage_return']
  }
}

Table notifications {
  id int [pk, not null, increment]
  user_id int [not null]
  reservation_id int
  type varchar(80) [not null]
  message text [not null]
  is_read boolean [not null, default: false]
  sent_at timestamp [not null, default: `now()`]

  indexes {
    (user_id, is_read, sent_at) [name: 'idx_notifications_user_read_sent']
  }
}

Table audit_logs {
  id int [pk, not null, increment]
  company_id int
  user_id int
  entity_type varchar(80) [not null]
  entity_id int
  action varchar(120) [not null]
  details jsonb [not null, default: `'{}'::jsonb`]
  created_at timestamp [not null, default: `now()`]

  indexes {
    (company_id, created_at) [name: 'idx_audit_company_created']
  }

  Note: 'entity_id est une référence polymorphe : aucune clé étrangère SQL ne lui est associée.'
}

Table maintenance_events {
  id int [pk, not null, increment]
  resource_id int [not null]
  created_by_user_id int [not null]
  start_at timestamp [not null]
  end_at timestamp [not null]
  reason text [not null]
  created_at timestamp [not null, default: `now()`]

  indexes {
    (resource_id, start_at, end_at) [name: 'idx_maintenance_resource_range']
  }

  checks {
    `end_at > start_at` [name: 'chk_maintenance_dates']
  }

  Note: 'Un trigger SQL refuse les maintenances qui chevauchent des réservations bloquantes.'
}

Ref: users.company_id > companies.id [delete: restrict]
Ref: user_roles.user_id > users.id [delete: cascade]
Ref: user_roles.role_id > roles.id [delete: cascade]
Ref: role_permissions.role_id > roles.id [delete: cascade]
Ref: role_permissions.permission_id > permissions.id [delete: cascade]
Ref: resources.company_id > companies.id [delete: restrict]
Ref: resources.type_id > resource_types.id [delete: restrict]
Ref: resources.state_id > resource_states.id [delete: restrict]
Ref: resources.id - room_details.resource_id [delete: cascade]
Ref: resources.id - vehicle_details.resource_id [delete: cascade]
Ref: resources.id - equipment_details.resource_id [delete: cascade]
Ref: reservations.company_id > companies.id [delete: restrict]
Ref: reservations.resource_id > resources.id [delete: restrict]
Ref: reservations.user_id > users.id [delete: restrict]
Ref: reservations.status_id > reservation_status.id [delete: restrict]
Ref: reservation_participants.reservation_id > reservations.id [delete: cascade]
Ref: reservation_participants.user_id > users.id [delete: set null]
Ref: reservations.id - vehicle_usage.reservation_id [delete: cascade]
Ref: vehicle_usage.vehicle_id > resources.id [delete: restrict]
Ref: notifications.user_id > users.id [delete: cascade]
Ref: notifications.reservation_id > reservations.id [delete: cascade]
Ref: audit_logs.company_id > companies.id [delete: set null]
Ref: audit_logs.user_id > users.id [delete: set null]
Ref: maintenance_events.resource_id > resources.id [delete: cascade]
Ref: maintenance_events.created_by_user_id > users.id [delete: restrict]